# .env.example
# Copy this to .env and fill in your actual values

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MetroStack API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=metrostack
POSTGRES_DB=metrostack

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/metrostack/uploads
MAX_UPLOAD_SIZE_MB=2048

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Analysis Defaults ─────────────────────────────────────────────────────────
ICP_MAX_CORRESPONDENCE_DIST_MM=5.0
ICP_MAX_ITERATIONS=200
ICP_RELATIVE_FITNESS=0.000001
ICP_RELATIVE_RMSE=0.000001

DEVIATION_DOWNSAMPLE_VOXEL_MM=0.2
DEVIATION_MAX_POINTS_REALTIME=500000
DEVIATION_BATCH_SIZE=100000

WALL_THICKNESS_SAMPLE_COUNT=20000
WALL_THICKNESS_RAY_OFFSET_MM=0.01

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
